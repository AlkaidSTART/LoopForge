{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CODEBUDDY_PROJECT_DIR/.codebuddy/hooks/approve-safe-commands.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "send_message",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CODEBUDDY_PROJECT_DIR/.codebuddy/hooks/devflow-auto-dispatch.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
